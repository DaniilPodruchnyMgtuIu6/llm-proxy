# Server
ADDR=:8080

# PostgreSQL (app + docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=llmproxy
DB_PASSWORD=llmproxy
DB_NAME=llmproxy
DB_SSLMODE=disable

# pgAdmin → http://localhost:5050
PGADMIN_DEFAULT_EMAIL=admin@llm-proxy.local
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# Providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

OPENAPI_PATH=api/openapi.yaml
