# ============================================================
# LLM Proxy — конфиг для запуска (НЕ коммитьте реальный .env)
# 1) Скопируйте этот файл в .env
# 2) Вставьте СВОИ ключи (достаточно одного провайдера)
# 3) Запустите scripts/start.ps1 или scripts/start.sh
# ============================================================

# --- Ключи провайдеров (подставьте свои) ---
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq:   https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Порты на вашей машине ---
PROXY_PORT=8080
UI_PORT=3000
DB_PORT=5432
PGADMIN_PORT=5050

# Runtime keys/defaults from UI (inside container: /data)
RUNTIME_DATA_DIR=.runtime

# --- PostgreSQL (внутри Docker имя хоста для приложения — postgres) ---
# Для локального `go run` используйте DB_HOST=localhost
DB_HOST=localhost
DB_USER=llmproxy
DB_PASSWORD=llmproxy
DB_NAME=llmproxy
DB_SSLMODE=disable

# --- pgAdmin → http://localhost:5050 ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- Прочее ---
ADDR=:8080
# Логи: error | info | debug (debug = попытки fallback, sanitize, upstream_id)
LOG_LEVEL=info

# Reliability
# Опциональная защита API (пусто = без auth). Header: Authorization: Bearer … или X-API-Key
PROXY_API_KEY=
UPSTREAM_TIMEOUT=60s
MAX_FALLBACK_ATTEMPTS=3
MODELS_CACHE_TTL=45s
CIRCUIT_BREAKER_ERRORS=5
CIRCUIT_BREAKER_COOLDOWN=5m

OPENAPI_PATH=api/openapi.yaml
OPENROUTER_SITE_URL=http://localhost:8080
OPENROUTER_SITE_TITLE=llm-proxy
