# ============================================================
# LLM Proxy — конфиг для запуска (НЕ коммитьте реальный .env)
# 1) Скопируйте этот файл в .env
# 2) Вставьте СВОИ ключи (достаточно одного провайдера)
# 3) Запустите scripts/start.ps1 или scripts/start.sh
# ============================================================

# --- Ключи провайдеров (подставьте свои) ---
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq:   https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Порты на вашей машине ---
PROXY_PORT=8080
DB_PORT=5432
PGADMIN_PORT=5050

# --- PostgreSQL (внутри Docker имя хоста для приложения — postgres) ---
# Для локального `go run` используйте DB_HOST=localhost
DB_HOST=localhost
DB_USER=llmproxy
DB_PASSWORD=llmproxy
DB_NAME=llmproxy
DB_SSLMODE=disable

# --- pgAdmin → http://localhost:5050 ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- Прочее ---
ADDR=:8080
# Логи: error | info | debug (debug = попытки fallback, sanitize, upstream_id)
LOG_LEVEL=info
OPENAPI_PATH=api/openapi.yaml
OPENROUTER_SITE_URL=http://localhost:8080
OPENROUTER_SITE_TITLE=llm-proxy
